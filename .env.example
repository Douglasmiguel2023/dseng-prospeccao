# Copie para .env.local no desenvolvimento e configure as mesmas chaves em
# Production na Vercel. Nunca coloque valores reais neste arquivo.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
ADMIN_EMAIL="seu-email@exemplo.com"
# Hash bcrypt gerado com: npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH="$2b$12$COLOQUE_O_HASH_GERADO_AQUI"
# Opcional, apenas como fallback se o hash desencontrar (lição do sistema de
# propostas). Prefira o hash; se definir esta variável, guarde-a só na Vercel.
# ADMIN_PASSWORD="sua-senha-forte"
AUTH_SECRET="gere-uma-string-longa-e-aleatoria"
# Opcional, só para a API de fila do Muse (GET /api/queue/pending e
# POST /api/rounds/[id]/leads, com header x-muse-token). Se não estiver
# definida, a API responde 503 e nunca aceita chamadas. Guarde só na Vercel.
MUSE_IMPORT_TOKEN="gere-um-token-longo-e-aleatorio-so-para-a-fila"
NEXT_PUBLIC_APP_URL="https://seu-projeto.vercel.app"
